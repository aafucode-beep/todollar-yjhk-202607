# ============ 环境变量示例 ============
# 复制本文件为 .env（本地开发）或 .env.production（VPS 部署），并填入真实值。
# 注意：.env 文件不会被提交到 Git。

# --- 数据库（本地 SQLite，文件保存在 VPS 上，无需外部数据库服务）---
# 路径相对于项目根目录下的 prisma/ 目录。默认会生成 prisma/prod.db
DATABASE_URL="file:./prod.db"

# --- NextAuth 认证配置 ---
# 部署后填你的域名，例如 https://todo.example.com；本地开发用 http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# 会话加密密钥。用命令生成：openssl rand -base64 32
NEXTAUTH_SECRET="请替换为随机字符串"
